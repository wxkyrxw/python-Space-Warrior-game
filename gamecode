def game_loop(is_2p, p1_idx, p2_idx):
    global screen_shake, save_data
    players = [Player2D(p1_idx, 1)]
    if is_2p: players.append(Player2D(p2_idx, 2))
    
    enemies, bullets, particles, boss = [], [], [], None
    session_score, game_over = 0, False
    stage, map_progress = 1, 0 
    map_length = 8000 + (stage * 2000)
    boss_spawns = [map_length // 2, map_length] 
    boss_active, sector_clear_timer = False, 0
    
    render_surf = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT))
    ENEMY_SPAWN = pygame.USEREVENT + 1
    pygame.time.set_timer(ENEMY_SPAWN, max(500, 1200 - (stage * 100))) 

    while True:
        clock.tick(FPS); render_surf.fill(BLACK)
        p1_in = get_input(1); p2_in = get_input(2) if is_2p else (0,0,False,False)
        
        global_boost = any(p.active and p.stamina > 0 and (p1_in[2] if p.player_id==1 else p2_in[2]) for p in players)
        speed_mult = 3 if global_boost else 1

        if not game_over and not boss_active and sector_clear_timer == 0:
            map_progress += speed_mult
            if boss_spawns and map_progress >= boss_spawns[0]:
                is_final = len(boss_spawns) == 1
                boss_spawns.pop(0)
                boss = MiniBoss(stage=stage + (1 if is_final else 0))
                boss_active = True; enemies.clear()

        if sector_clear_timer > 0:
            sector_clear_timer -= 1
            if sector_clear_timer == 0:
                stage += 1; map_progress = 0
                map_length = 8000 + (stage * 2000)
                boss_spawns = [map_length // 2, map_length]
                pygame.time.set_timer(ENEMY_SPAWN, max(400, 1200 - (stage * 100)))
                for p in players:
                    if not p.active: p.active = True; p.x, p.y = WINDOW_WIDTH//2, WINDOW_HEIGHT - 100
                    p.hp = p.max_hp; p.stamina = p.max_stamina

        for event in pygame.event.get():
            if event.type == pygame.QUIT: closing_animation()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_F11: toggle_fullscreen()
                if game_over and event.key == pygame.K_RETURN: return "restart"
                if game_over and event.key == pygame.K_ESCAPE: return "menu"
            
            if event.type == pygame.JOYBUTTONDOWN and game_over:
                if event.button in [0, 1, 7, 9]: return "restart" 
                if event.button in [2, 3]: return "menu" 
                
            if not game_over and not boss_active and sector_clear_timer == 0 and event.type == ENEMY_SPAWN: 
                enemies.append(Enemy2D(stage=stage))

        for star in stars:
            star[1] += star[2] * speed_mult
            if star[1] > WINDOW_HEIGHT: star[1] = 0; star[0] = random.randint(0, WINDOW_WIDTH)
            pygame.draw.rect(render_surf, (150, 150, 200), (star[0], star[1], star[2], star[2]*2))

        if not game_over:
            if players[0].active: players[0].update(particles, p1_in[0], p1_in[1], p1_in[2], p1_in[3], bullets)
            if is_2p and players[1].active: players[1].update(particles, p2_in[0], p2_in[1], p2_in[2], p2_in[3], bullets)
            for b in bullets: b.update()
            for e in enemies: e.update(bullets)
            for p in particles: p.update()
            if boss and boss.active: boss.update(bullets, particles)

            for b in bullets:
                if not b.active: continue
                if b.is_player:
                    for e in enemies:
                        if e.active and math.hypot(e.x - b.x, e.y - b.y) < e.hitbox_radius + b.radius:
                            e.hit(particles); b.active = False; session_score += 50; break
                    if boss and boss.active and math.hypot(boss.x - b.x, boss.y - b.y) < boss.hitbox_radius + b.radius:
                        boss.hit(particles); b.active = False; session_score += 10
                else:
                    for p in players:
                        if p.active and math.hypot(p.x - b.x, p.y - b.y) < p.hitbox_radius + p.hitbox_radius:
                            if p.take_damage(33, particles): b.active = False

            for p in players:
                if not p.active: continue
                for e in enemies:
                    if e.active and math.hypot(e.x - p.x, e.y - p.y) < e.hitbox_radius + p.hitbox_radius:
                        if p.take_damage(33, particles): e.active = False
                if boss and boss.active and math.hypot(boss.x - p.x, boss.y - p.y) < boss.hitbox_radius + p.hitbox_radius - 20:
                    p.take_damage(33, particles)

            if boss and not boss.active: 
                boss = None; boss_active = False; session_score += 1000 * stage
                if len(boss_spawns) == 0: sector_clear_timer = 180 
            
            if not any(p.active for p in players): 
                game_over = True
                save_data["score"] += session_score; save_game(save_data)

        bullets = [b for b in bullets if b.active]
        enemies = [e for e in enemies if e.active]
        particles = [p for p in particles if p.active]

        if boss: boss.draw(render_surf)
        for b in bullets: b.draw(render_surf)
        for e in enemies: e.draw(render_surf)
        for p in players: p.draw(render_surf)
        for p in particles: p.draw(render_surf)

        draw_text(render_surf, f"{t('session_score')}: {session_score}", font_large, WHITE, 20, 30, align="left")
        draw_text(render_surf, f"{t('stage')} {stage}", font_large, CYAN, WINDOW_WIDTH - 20, 30, align="right")
        
        pr = min(1.0, map_progress / map_length)
        pygame.draw.rect(render_surf, (50, 50, 50), (WINDOW_WIDTH//2 - 200, 20, 400, 10))
        pygame.draw.rect(render_surf, CYAN if sector_clear_timer == 0 else GREEN, (WINDOW_WIDTH//2 - 200, 20, 400 * pr, 10))

        if sector_clear_timer > 0:
            draw_text(render_surf, t('sector_cleared'), font_massive, GREEN, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 - 40)
            draw_text(render_surf, t('prepare_stage').format(stage=stage + 1), font_large, WHITE, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 + 20)
            draw_text(render_surf, t('hull_repaired'), font_small, CYAN, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 + 60)

        if game_over:
            pygame.draw.rect(render_surf, (0, 0, 0, 200), (0, WINDOW_HEIGHT//2 - 80, WINDOW_WIDTH, 160))
            draw_text(render_surf, t('mission_failed'), font_massive, YELLOW, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 - 20)
            draw_text(render_surf, t('credits_saved').format(score=session_score), font_small, GREEN, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 + 25)
            draw_text(render_surf, t('game_over_hint'), font_small, WHITE, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 + 55)

        draw_esc_progress(render_surf)
        
        b_val = save_data.get("brightness", 1.0)
        if b_val != 1.0:
            bright_surf = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.SRCALPHA)
            if b_val > 1.0: bright_surf.fill((255, 255, 255, int((b_val - 1.0) * 150)))
            else: bright_surf.fill((0, 0, 0, int((1.0 - b_val) * 180)))
            render_surf.blit(bright_surf, (0, 0))

        screen.fill(BLACK)
        screen.blit(render_surf, (random.randint(-screen_shake, screen_shake) if screen_shake > 0 else 0, random.randint(-screen_shake, screen_shake) if screen_shake > 0 else 0))
        if screen_shake > 0: screen_shake -= 1
        pygame.display.flip()

if __name__ == "__main__":
    opening_animation()
    while True:
        is_2p, p1_idx, p2_idx = main_menu() 
        while True:
            action = game_loop(is_2p, p1_idx, p2_idx) 
            if action == "menu": break 
            elif action == "restart": continue
