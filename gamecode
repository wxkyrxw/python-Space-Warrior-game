# --- YARDIMCI METİN ÇİZİMİ ---
def draw_text(surface, text, font, color, x, y, align="center", alpha=255):
    text_obj = font.render(text, False, color)
    if alpha < 255: text_obj.set_alpha(alpha)
    rect = text_obj.get_rect()
    if align == "center": rect.center = (x, y)
    elif align == "left": rect.topleft = (x, y)
    elif align == "right": rect.topright = (x, y)
    
    shadow = font.render(text, False, BLACK)
    if alpha < 255: shadow.set_alpha(alpha)
    s_rect = shadow.get_rect(center=(rect.centerx+2, rect.centery+2)) if align=="center" else (shadow.get_rect(topleft=(rect.x+2, rect.y+2)) if align=="left" else shadow.get_rect(topright=(rect.right+2, rect.y+2)))
    
    surface.blit(shadow, s_rect); surface.blit(text_obj, rect)

