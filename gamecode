class Player2D:
    def __init__(self, ship_idx, player_id):
        self.ship_idx, self.player_id = ship_idx, player_id
        self.level = save_data["levels"][str(self.ship_idx)]
        self.base_data = SHIPS[self.ship_idx]
        self.lvl_data = self.base_data["levels"][self.level]
        
        self.max_hp = self.base_data["max_hp"]
        self.hp = self.max_hp
        self.max_stamina = self.base_data["max_stamina"]
        self.stamina = self.max_stamina
        self.invuln_time = 0
        
        self.x = WINDOW_WIDTH // 3 if player_id == 1 else (WINDOW_WIDTH // 3) * 2
        self.y = WINDOW_HEIGHT - 100
        self.frames, self.image = self.lvl_data["frames"], self.lvl_data["frames"]["straight"]
        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.speed, self.shoot_delay = self.lvl_data["speed"], self.lvl_data["delay"]
        self.last_shot, self.active = pygame.time.get_ticks(), True
        self.hitbox_radius = 12 + (self.level * 2)

    def take_damage(self, amount, particles):
        now = pygame.time.get_ticks()
        if now < self.invuln_time: return False
        self.hp -= amount
        self.invuln_time = now + 1000
        global screen_shake; screen_shake = max(screen_shake, 15)
        if self.hp <= 0:
            self.active = False
            for _ in range(40): particles.append(Particle2D(self.x, self.y, WHITE, vx=random.uniform(-10,10), vy=random.uniform(-10,10), size=7))
        else:
            for _ in range(15): particles.append(Particle2D(self.x, self.y, YELLOW, vx=random.uniform(-5,5), vy=random.uniform(-5,5), size=4))
        return True

    def update(self, parts, move_x, move_y, is_boost, is_shoot, bullets):
        can_boost = is_boost and self.stamina > 0
        if can_boost:
            self.stamina = max(0, self.stamina - 1.5)
            curr_speed = self.speed * 1.5
        else:
            self.stamina = min(self.max_stamina, self.stamina + 0.8)
            curr_speed = self.speed

        self.x += move_x * curr_speed; self.y += move_y * curr_speed
        if move_x < -0.2: self.image = self.frames["left"]
        elif move_x > 0.2: self.image = self.frames["right"]
        else: self.image = self.frames["straight"]

        self.x = max(40, min(WINDOW_WIDTH - 40, self.x))
        self.y = max(40, min(WINDOW_HEIGHT - 40, self.y))
        self.rect.center = (self.x, self.y)

        if can_boost and random.random() > 0.2:
            parts.append(Particle2D(self.x + random.randint(-8,8), self.y + 20+(self.level*5), self.base_data["thruster"], vy=random.uniform(5, 12), size=6))

        now = pygame.time.get_ticks()
        if is_shoot and now - self.last_shot > (self.shoot_delay * 0.7 if can_boost else self.shoot_delay):
            self.fire(bullets); self.last_shot = now

    def fire(self, bullets):
        c = self.base_data["color"]
        name = self.base_data["name"]
        if name == "CYBER-FALCON":
            spd = -30
            if self.level == 1: bullets.append(Bullet2D(self.x, self.y - 10, c, vy=spd))
            elif self.level == 2:
                bullets.append(Bullet2D(self.x - 8, self.y - 10, c, vy=spd))
                bullets.append(Bullet2D(self.x + 8, self.y - 10, c, vy=spd))
            elif self.level == 3:
