            if self.level == 1:
                bullets.append(Bullet2D(self.x, self.y - 10, c, vy=spd))
                bullets.append(Bullet2D(self.x, self.y - 10, c, vx=-4, vy=spd))
                bullets.append(Bullet2D(self.x, self.y - 10, c, vx=4, vy=spd))
            elif self.level == 2: 
                bullets.append(Bullet2D(self.x - 10, self.y, c, vy=spd))
                bullets.append(Bullet2D(self.x + 10, self.y, c, vy=spd))
                bullets.append(Bullet2D(self.x, self.y - 10, c, vx=-5, vy=spd))
