# --- KAYIT SİSTEMİ (SAVE DATA) ---
SAVE_FILE = "neon_save.json"

def load_save():
    if os.path.exists(SAVE_FILE):
        try:
            with open(SAVE_FILE, 'r') as f: 
                data = json.load(f)
                if "brightness" not in data: data["brightness"] = 1.0
                if "language" not in data: data["language"] = "TR"
                return data
        except: pass
    return {"score": 0, "levels": {"0": 1, "1": 1, "2": 1}, "brightness": 1.0, "language": "TR"}

def save_game(data):
    with open(SAVE_FILE, 'w') as f: json.dump(data, f)

save_data = load_save()

def t(key):
    lang = save_data.get("language", "TR")
    return LANG[lang].get(key, key)

