                bullets.append(Bullet2D(self.x, self.y - 15, c, vy=spd))
            elif self.level == 3:
                bullets.append(Bullet2D(self.x - 15, self.y, c, vy=spd))
                bullets.append(Bullet2D(self.x, self.y - 10, c, vy=spd))
                bullets.append(Bullet2D(self.x + 15, self.y, c, vy=spd))
                bullets.append(Bullet2D(self.x - 10, self.y, c, vx=-5, vy=spd))
                bullets.append(Bullet2D(self.x - 10, self.y, c, vx=-8, vy=spd))
                bullets.append(Bullet2D(self.x + 10, self.y, c, vx=5, vy=spd))
                bullets.append(Bullet2D(self.x + 10, self.y, c, vx=8, vy=spd))
