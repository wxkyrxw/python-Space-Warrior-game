def opening_animation():
    total_frames = 180  
    for i in range(total_frames):
        clock.tick(FPS)
        screen.fill(BLACK)
        alpha = int(255 * (i / 60)) if i < 60 else (255 if i < 120 else int(255 * (1 - ((i - 120) / 60))))
        draw_text(screen, "SPACE WARRIOR", font_massive, CYAN, WINDOW_WIDTH//2, WINDOW_HEIGHT//2 - 20, alpha=alpha)
        draw_text(screen, "Developed By wxkyrxw", font_small, CYAN, WINDOW_WIDTH - 20, WINDOW_HEIGHT - 20, align="right", alpha=min(alpha, 130))
        pygame.display.flip()

def closing_animation():
    fade_surf = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.SRCALPHA)
    for i in range(60):
        clock.tick(FPS)
        fade_surf.fill((0, 0, 0, int(255 * (i / 60))))
        screen.blit(fade_surf, (0, 0))
        draw_text(screen, "GOOD BYE", font_massive, CYAN, WINDOW_WIDTH//2, WINDOW_HEIGHT//2, alpha=int(255 * (i / 60)))
        pygame.display.flip()
    pygame.quit()
    sys.exit()

# --- GRAFİK ÜRETİMİ ---
def create_ship_surface(pattern, pixel_size=6):
    width = len(pattern[0]) * pixel_size
    height = len(pattern) * pixel_size
    main_surf = pygame.Surface((width, height), pygame.SRCALPHA)
    color_map = {'C': CYAN, 'W': WHITE, 'M': MAGENTA, 'Y': YELLOW, 'R': (255,30,30), 'O': ORANGE, 'D': (40,40,40), 'G': GREEN}
    
    for row_idx, row in enumerate(pattern):
        for col_idx, char in enumerate(row):
            if char in color_map:
                rx, ry = col_idx * pixel_size, row_idx * pixel_size
                pygame.draw.rect(main_surf, color_map[char], (rx, ry, pixel_size, pixel_size))
                pygame.draw.rect(main_surf, WHITE, (rx + 1, ry + 1, pixel_size - 2, pixel_size - 2))
    return main_surf

def generate_ship_frames(pattern, color, pixel_size=6):
    base = create_ship_surface(pattern, pixel_size)
    container = pygame.Surface((base.get_width() + 40, base.get_height() + 40), pygame.SRCALPHA)
    container.blit(base, (20, 20))
    return {"straight": container, "left": pygame.transform.rotate(container, 15), "right": pygame.transform.rotate(container, -15)}

