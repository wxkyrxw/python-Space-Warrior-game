    def draw(self, surface):
        if not self.active: return
        now = pygame.time.get_ticks()
        if now < self.invuln_time and (now // 100) % 2 == 0: pass 
        else: surface.blit(self.image, self.rect)
        
        bar_w, bar_h = 40, 4
        hp_ratio = max(0, self.hp / self.max_hp)
        pygame.draw.rect(surface, (255,30,30), (self.x - bar_w//2, self.y + 40, bar_w, bar_h))
        pygame.draw.rect(surface, GREEN, (self.x - bar_w//2, self.y + 40, int(bar_w * hp_ratio), bar_h))
        
