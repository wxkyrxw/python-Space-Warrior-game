        pygame.draw.rect(surface, CYAN, (self.x - bar_w//2, self.y + 46, int(bar_w * stam_ratio), bar_h))


class Enemy2D:
    def __init__(self, stage=1):
        self.type = random.choices(["cruiser", "hunter", "hornet"], weights=[50, 30, 20])[0]
        self.x = random.randint(50, WINDOW_WIDTH - 50)
        self.y = -50
        if self.type == "cruiser":
            self.image, self.hp, self.vy, self.hitbox_radius = E1_SURF, 2 + (stage // 2), random.uniform(3, 5) + (stage * 0.3), 20
        elif self.type == "hunter": 
            self.image, self.hp, self.vy, self.hitbox_radius = E2_SURF, 1 + (stage // 3), random.uniform(2, 4) + (stage * 0.3), 15
            self.last_shot, self.shoot_delay = pygame.time.get_ticks(), random.randint(1500, 2500)
        elif self.type == "hornet": 
            self.image, self.hp, self.vy, self.hitbox_radius = E3_SURF, 1, random.uniform(4, 7) + (stage * 0.5), 12
            self.base_x, self.time_offset = self.x, random.uniform(0, 100)

        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.active, self.stage = True, stage

    def update(self, bullets_list=None):
        self.y += self.vy
        if self.type == "hornet": self.x = self.base_x + math.sin((pygame.time.get_ticks() / 300) + self.time_offset) * 80
        self.rect.center = (self.x, self.y)
        if self.type == "hunter" and bullets_list is not None:
            now = pygame.time.get_ticks()
            if now - self.last_shot > max(500, self.shoot_delay - (self.stage * 100)):
                bullets_list.append(Bullet2D(self.x, self.y + 10, CYAN, vx=0, vy=8 + (self.stage * 0.5), is_player=False))
                self.last_shot = now
        if self.y > WINDOW_HEIGHT + 50: self.active = False

    def hit(self, parts):
        self.hp -= 1
        c = YELLOW if self.type == "cruiser" else (WHITE if self.type == "hunter" else ORANGE)
        for _ in range(3): parts.append(Particle2D(self.x, self.y, c, vx=random.uniform(-3,3), vy=random.uniform(-3,3), size=5))
        if self.hp <= 0:
            for _ in range(10): parts.append(Particle2D(self.x, self.y, YELLOW, vx=random.uniform(-6,6), vy=random.uniform(-6,6), size=6))
            self.active = False

    def draw(self, surface):
        if self.active: surface.blit(self.image, self.rect)


class MiniBoss:
    def __init__(self, stage=1):
        self.x, self.y = WINDOW_WIDTH // 2, -100
        self.image = BOSS_SURFACE
        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.hp = self.max_hp = 80 + (stage * 30)
        self.active = True; self.hitbox_radius = 50
        self.state = "entering"; self.dir = 1; self.last_shot = pygame.time.get_ticks()
        self.stage = stage
        
    def update(self, bullets, parts):
        if self.state == "entering":
            self.y += 2
            if self.y >= 150: self.state = "fighting"
        elif self.state == "fighting":
            self.x += (3 + self.stage * 0.5) * self.dir
            if self.x > WINDOW_WIDTH - 100: self.dir = -1
            elif self.x < 100: self.dir = 1
            now = pygame.time.get_ticks()
            if now - self.last_shot > max(300, 800 - (self.stage * 50)):
                bullets.append(Bullet2D(self.x - 30, self.y + 40, ORANGE, vy=9 + (self.stage * 0.5), is_player=False))
                bullets.append(Bullet2D(self.x + 30, self.y + 40, ORANGE, vy=9 + (self.stage * 0.5), is_player=False))
                bullets.append(Bullet2D(self.x, self.y + 50, YELLOW, vy=11 + (self.stage * 0.5), is_player=False))
                self.last_shot = now
        self.rect.center = (self.x, self.y)
        
    def hit(self, parts):
        self.hp -= 1
        if self.hp <= 0:
            global screen_shake; screen_shake = 40
            for _ in range(40): parts.append(Particle2D(self.x, self.y, ORANGE, vx=random.uniform(-15,15), vy=random.uniform(-15,15), size=12))
            self.active = False
            
    def draw(self, surface):
        if self.active:
            surface.blit(self.image, self.rect)
            if self.state == "fighting":
                pygame.draw.rect(surface, (255,30,30), (self.x - 50, self.y - 60, 100, 5))
                pygame.draw.rect(surface, GREEN, (self.x - 50, self.y - 60, 100 * (self.hp/self.max_hp), 5))


class Bullet2D:
    def __init__(self, x, y, color, vx=0, vy=-20, is_player=True):
        self.x, self.y, self.vx, self.vy = x, y, vx, vy
        self.color, self.active, self.is_player = color, True, is_player
        self.radius = 4
        
    def update(self):
        self.x += self.vx; self.y += self.vy
        if self.y < -50 or self.y > WINDOW_HEIGHT + 50 or self.x < -50 or self.x > WINDOW_WIDTH + 50: self.active = False
            
    def draw(self, surface):
        if not self.active: return
        speed_mag = math.hypot(self.vx, self.vy) + 0.001
        dx, dy = (self.vx / speed_mag) * 20, (self.vy / speed_mag) * 20 
        pygame.draw.line(surface, self.color, (self.x, self.y), (self.x - dx, self.y - dy), 6)
        pygame.draw.line(surface, WHITE, (self.x, self.y), (self.x - dx, self.y - dy), 2)


class Particle2D:
    def __init__(self, x, y, color, vx=0, vy=0, size=5):
        self.x, self.y, self.vx, self.vy, self.color, self.size = x, y, vx, vy, color, size
        self.lifetime = self.max_life = random.randint(15, 30); self.active = True
    def update(self):
        self.x += self.vx; self.y += self.vy; self.lifetime -= 1
        if self.lifetime <= 0: self.active = False
    def draw(self, surface):
        if not self.active: return
        r = max(1, int(self.size * (self.lifetime / self.max_life)))
        pygame.draw.circle(surface, self.color, (int(self.x), int(self.y)), r)

def draw_esc_progress(surface):
    global esc_hold_time
    keys = pygame.key.get_pressed()
    if keys[pygame.K_ESCAPE]:
        esc_hold_time += 1
        if esc_hold_time >= MAX_ESC_HOLD: closing_animation()
    else:
        esc_hold_time = max(0, esc_hold_time - 2)

    if esc_hold_time > 0:
        center, radius = (45, 45), 25
        ratio = esc_hold_time / MAX_ESC_HOLD
        pygame.draw.circle(surface, (20, 20, 30), center, radius)
        pygame.draw.circle(surface, CYAN, center, radius, 3)
        inner_r = int(radius * ratio)
        if inner_r > 0: pygame.draw.circle(surface, MAGENTA, center, inner_r)
        draw_text(surface, "ESC", font_small, WHITE, center[0], center[1])

def toggle_fullscreen():
    global is_fullscreen, screen
    is_fullscreen = not is_fullscreen
    screen = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.FULLSCREEN | pygame.SCALED if is_fullscreen else pygame.SCALED)

def get_input(p_id):
    x, y, boost, fire = 0, 0, False, False
    keys = pygame.key.get_pressed()
    
    if p_id == 1:
        if keys[pygame.K_a]: x -= 1
        if keys[pygame.K_d]: x += 1
        if keys[pygame.K_w]: y -= 1
        if keys[pygame.K_s]: y += 1
        if keys[pygame.K_LSHIFT]: boost = True
        if keys[pygame.K_SPACE]: fire = True
    else:
        if keys[pygame.K_LEFT]: x -= 1
        if keys[pygame.K_RIGHT]: x += 1
        if keys[pygame.K_UP]: y -= 1
        if keys[pygame.K_DOWN]: y += 1
        if keys[pygame.K_RSHIFT]: boost = True
        if keys[pygame.K_RETURN]: fire = True

    if p_id == 1 and joysticks:
        j = joysticks[0]
        ax, ay = j.get_axis(0), j.get_axis(1)
        if abs(ax) > 0.15: x = ax
        if abs(ay) > 0.15: y = ay
        if j.get_numhats() > 0:
            hx, hy = j.get_hat(0)
            if hx != 0: x = hx
            if hy != 0: y = -hy
        if j.get_numbuttons() >= 15:
            if j.get_button(11): y = -1 
            if j.get_button(12): y = 1  
            if j.get_button(13): x = -1 
            if j.get_button(14): x = 1  
        if j.get_button(0) or j.get_button(1) or j.get_button(2) or j.get_button(3): fire = True
        if j.get_button(4) or j.get_button(5) or (j.get_numaxes() > 4 and j.get_axis(4) > 0.1) or (j.get_numaxes() > 5 and j.get_axis(5) > 0.1): boost = True

    length = math.hypot(x, y)
    if length > 1: x /= length; y /= length
    return x, y, boost, fire

def attempt_upgrade(ship_idx):
    if ship_idx is None: return
    current_lvl = save_data["levels"][str(ship_idx)]
    if current_lvl < 3:
        cost = SHIPS[ship_idx]["levels"][current_lvl + 1]["cost"]
        if save_data["score"] >= cost:
            save_data["score"] -= cost; save_data["levels"][str(ship_idx)] += 1; save_game(save_data)

def draw_ship_preview(surface, ship_idx, x, y, label, color):
    current_lvl = save_data["levels"][str(ship_idx)]
    info = SHIPS[ship_idx]["levels"][current_lvl]
    surface.blit(info["frames"]["straight"], (x, y))
    
    draw_text(surface, f"{label} - LEVEL {current_lvl}", font_small, color, x + 30, y + 100)
    draw_text(surface, f"HP: {SHIPS[ship_idx]['max_hp']} | STAM: {SHIPS[ship_idx]['max_stamina']}", font_small, WHITE, x + 30, y + 120)
    
    if current_lvl < 3:
        cost = SHIPS[ship_idx]["levels"][current_lvl + 1]["cost"]
        draw_text(surface, f"{t('upgrade')}: {cost} CR", font_small, GREEN if save_data["score"] >= cost else YELLOW, x + 30, y + 145)
    else:
        draw_text(surface, t('max_level'), font_small, ORANGE, x + 30, y + 145)

